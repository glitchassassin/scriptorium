{
  "name": "scriptorium",
  "description": "Experimental single-user app for browsing local workspaces and running OpenCode-backed coding sessions.",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glitchassassin/scriptorium.git"
  },
  "homepage": "https://github.com/glitchassassin/scriptorium",
  "bugs": {
    "url": "https://github.com/glitchassassin/scriptorium/issues"
  },
  "type": "module",
  "bin": {
    "scriptorium": "./bin/scriptorium.js"
  },
  "files": [
    "bin/",
    "build/client/",
    "build/runtime/",
    "build/server/",
    "docs/config.md",
    "drizzle/",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "react-router build && npm run build:runtime",
    "build:runtime": "tsc -p tsconfig.runtime.json",
    "dev": "cross-env NODE_ENV=development node server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "docs:config": "node ./scripts/generate-config-docs.ts",
    "prepack": "npm run docs:config && npm run build",
    "start": "node ./bin/scriptorium.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@iconify-json/mdi": "^1.1.67",
    "@iconify/react": "^5.0.2",
    "@react-router/express": "7.12.0",
    "@react-router/node": "7.12.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "compression": "^1.8.1",
    "drizzle-orm": "^1.0.0-beta.17-8a36f93",
    "express": "^4.21.2",
    "isbot": "^5.1.31",
    "morgan": "^1.10.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router": "7.12.0",
    "react-router-auto-routes": "^0.8.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@react-router/dev": "7.12.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.12.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^1.0.0-beta.17-8a36f93",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.18"
  }
}
