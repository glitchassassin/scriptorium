{
  "extends": "./tsconfig.json",
  "include": [
    "app/lib/runtime-config/**/*.ts",
    "server/**/*.ts"
  ],
  "exclude": [
    "app/lib/runtime-config/**/*.test.ts"
  ],
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "build/runtime",
    "rootDir": ".",
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "jsx": "preserve"
  }
}
