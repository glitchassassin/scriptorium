{
  "extends": "./tsconfig.json",
  "include": [
    "app/lib/runtime-config.server.ts",
    "cli/**/*.ts"
  ],
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "build/runtime",
    "rootDir": ".",
    "noEmit": false,
    "jsx": "preserve"
  }
}
